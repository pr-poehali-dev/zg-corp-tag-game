{
  "tests": [
    {
      "name": "Register new user",
      "method": "POST",
      "path": "/",
      "body": {"action": "register", "username": "testuser99", "password": "pass1234"},
      "expectedStatus": 200,
      "expectedBody": {"ok": true},
      "bodyMatcher": "partial"
    },
    {
      "name": "Login existing user",
      "method": "POST",
      "path": "/",
      "body": {"action": "login", "username": "testuser99", "password": "pass1234"},
      "expectedStatus": 200,
      "expectedBody": {"ok": true},
      "bodyMatcher": "partial"
    },
    {
      "name": "Wrong password",
      "method": "POST",
      "path": "/",
      "body": {"action": "login", "username": "testuser99", "password": "wrong"},
      "expectedStatus": 401,
      "expectedBody": {"error": "Неверное имя или пароль"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Empty fields",
      "method": "POST",
      "path": "/",
      "body": {"action": "register", "username": "", "password": ""},
      "expectedStatus": 400,
      "bodyMatcher": "partial"
    }
  ]
}
